  employee           Employee  @relation("TimetableEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  createdByEmployee  Employee? @relation("TimetableCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByEmployee  Employee? @relation("TimetableUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([employeeId], map: "idx_timetables_employee_id")
