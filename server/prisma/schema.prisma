model StoredValueAccount {
  id                BigInt                             @id @default(autoincrement())
  memberId          BigInt                             @map("member_id")
  storedValue       Decimal                            @default(0.00) @map("stored_value") @db.Decimal(10, 2)
  createdBy         BigInt?                            @map("created_by")
  lastUpdatedBy     BigInt?                            @map("last_updated_by")
  createdAt         DateTime                           @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                           @map("updated_at") @db.Timestamptz(6)
  
  member            Member                             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdByEmployee Employee?                          @relation("StoredValueAccountCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByEmployee Employee?                          @relation("StoredValueAccountUpdatedBy", fields: [lastUpdatedBy], references: [id], onDelete: SetNull)
