model StoredValueAccountTransactionLog {
  id                    BigInt             @id @default(autoincrement())
  storedValueAccountId  BigInt             @map("stored_value_account_id")
  storedValue           Decimal            @map("stored_value") @db.Decimal(10, 2)
  amountChanged         Decimal            @map("amount_changed") @db.Decimal(10, 2)
  transactionDate       DateTime           @map("transaction_date") @db.Timestamptz(6)
  type                  String             @db.VarChar(50)
  createdBy             BigInt?            @map("created_by")
  lastUpdatedBy         BigInt?            @map("last_updated_by")
  createdAt             DateTime           @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @map("updated_at") @db.Timestamptz(6)
  
  storedValueAccount    StoredValueAccount @relation(fields: [storedValueAccountId], references: [id], onDelete: Cascade)
  createdByEmployee     Employee?          @relation("SVATransactionLogCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByEmployee     Employee?          @relation("SVATransactionLogUpdatedBy", fields: [lastUpdatedBy], references: [id], onDelete: SetNull)

  @@index([storedValueAccountId], map: "idx_stored_value_accounts_transaction_logs_account_id")
  @@index([createdBy], map: "idx_stored_value_accounts_transaction_logs_created_by")
  @@index([lastUpdatedBy], map: "idx_stored_value_accounts_transaction_logs_updated_by")
  @@map("stored_value_accounts_transaction_logs")
}

model CustomTranslation {
  id              BigInt    @id @default(autoincrement())
  sourceText      String    @map("source_text") @db.VarChar(500)
  targetLanguage  String    @map("target_language") @db.VarChar(10)
  translatedText  String    @map("translated_text") @db.VarChar(1000)
  sourceLanguage  String    @default("en") @map("source_language") @db.VarChar(10)
  type            String    @default("personal") @map("type") @db.VarChar(20) // "global" or "personal"
  userId          BigInt?   @map("user_id") // null for global translations
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       BigInt    @map("created_by")

  creator         User      @relation("CustomTranslationCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  user            User?     @relation("CustomTranslationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sourceText, targetLanguage, sourceLanguage, type, userId], map: "custom_translations_unique_idx")
  @@index([targetLanguage], map: "custom_translations_target_language_idx")
  @@index([userId], map: "custom_translations_user_id_idx")
  @@index([type], map: "custom_translations_type_idx")
  @@map("custom_translations")
}

model Translation {
  id                BigInt   @id @default(autoincrement())
  english           String   @db.VarChar(255)
  chinese           String   @db.VarChar(255)
  meaningInEnglish  String   @map("meaning_in_english") @db.VarChar(255)
  meaningInChinese  String   @map("meaning_in_chinese") @db.VarChar(255)
  page              String?  @db.VarChar(255)
  createdAt         DateTime @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime @map("updated_at") @db.Timestamp(6)

  @@map("translations")
}